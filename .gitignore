# Runtime state and generated caches; never commit a live SQLite database.
.cache/
.venv/
__pycache__/
*.py[cod]
bot.db
bot.db-shm
bot.db-wal
.env

# Server wallet secret files (never application assets).
.secrets/
*.ton-seed

# Private runtime configuration; safe template is conf.example.json.
/conf.json
/conf.json.*
